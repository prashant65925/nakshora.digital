rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'prashantsharma659@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerified() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
      );
    }

    // 3. Entity Validation Helpers
    function isValidUserPublic(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'preferredLanguage', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'preferredLanguage', 'selectedCity', 'aiPersonalizationOptIn', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.preferredLanguage in ['en', 'hi']
        && (!('selectedCity' in data) || (data.selectedCity is string && data.selectedCity.size() <= 80))
        && (!('aiPersonalizationOptIn' in data) || data.aiPersonalizationOptIn is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'address', 'city', 'pincode', 'consentAcceptedAt', 'updatedAt'])
        && data.uid == userId
        && data.email is string && data.email.size() <= 160
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 20))
        && (!('address' in data) || (data.address is string && data.address.size() <= 300))
        && (!('city' in data) || (data.city is string && data.city.size() <= 80))
        && (!('pincode' in data) || (data.pincode is string && data.pincode.size() <= 10))
        && (!('consentAcceptedAt' in data) || data.consentAcceptedAt is timestamp)
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, adminId) {
      return data.keys().hasAll(['uid', 'email', 'role', 'active', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'active', 'createdAt'])
        && data.uid == adminId
        && data.email is string && data.email.size() <= 160
        && data.role in ['super_admin', 'catalog_admin', 'ops_admin']
        && data.active is bool
        && data.createdAt is timestamp;
    }

    function isValidWishlistItem(data) {
      return data.keys().hasAll(['productId', 'userId', 'createdAt'])
        && data.keys().hasOnly(['productId', 'userId', 'createdAt'])
        && isValidId(data.productId)
        && data.userId == request.auth.uid
        && data.createdAt is timestamp;
    }

    function isValidShoppingList(data, listId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'items', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'budgetInr', 'items', 'createdAt', 'updatedAt'])
        && data.id == listId
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && (!('budgetInr' in data) || (data.budgetInr is number && data.budgetInr >= 0 && data.budgetInr <= 10000000))
        && data.items is list && data.items.size() <= 100
        && (data.items.size() == 0 || data.items[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAiConversation(data, convId) {
      return data.keys().hasAll(['id', 'userId', 'language', 'prompt', 'reply', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'language', 'prompt', 'reply', 'createdAt'])
        && data.id == convId
        && data.userId == request.auth.uid
        && data.language in ['en', 'hi']
        && data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 1000
        && data.reply is string && data.reply.size() >= 1 && data.reply.size() <= 4000
        && data.createdAt is timestamp;
    }

    function isValidDirectOrder(data, orderId) {
      return data.keys().hasAll(['id', 'userId', 'items', 'totalInr', 'currency', 'paymentStatus', 'fulfillmentStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'items', 'totalInr', 'currency', 'shippingCity', 'shippingPincode', 'razorpayOrderId', 'razorpayPaymentId', 'paymentStatus', 'fulfillmentStatus', 'createdAt', 'updatedAt'])
        && data.id == orderId
        && data.userId is string && isValidId(data.userId)
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && data.items[0] is map
        && data.totalInr is number && data.totalInr > 0 && data.totalInr <= 5000000
        && data.currency == 'INR'
        && (!('shippingCity' in data) || (data.shippingCity is string && data.shippingCity.size() <= 80))
        && (!('shippingPincode' in data) || (data.shippingPincode is string && data.shippingPincode.size() <= 10))
        && (!('razorpayOrderId' in data) || (data.razorpayOrderId is string && data.razorpayOrderId.size() <= 120))
        && (!('razorpayPaymentId' in data) || (data.razorpayPaymentId is string && data.razorpayPaymentId.size() <= 120))
        && data.paymentStatus in ['created', 'pending_verification', 'verified_paid', 'failed', 'refunded', 'test_fixture']
        && data.fulfillmentStatus in ['awaiting_payment', 'processing', 'shipped', 'delivered', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRefund(data, refundId) {
      return data.keys().hasAll(['id', 'orderId', 'userId', 'amountInr', 'reason', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'orderId', 'userId', 'amountInr', 'reason', 'status', 'createdAt', 'updatedAt'])
        && data.id == refundId
        && isValidId(data.orderId)
        && data.userId is string && isValidId(data.userId)
        && data.amountInr is number && data.amountInr > 0 && data.amountInr <= 5000000
        && data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 300
        && data.status in ['requested', 'approved', 'processed', 'rejected']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSupportTicket(data, ticketId) {
      return data.keys().hasAll(['id', 'userId', 'subject', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'subject', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.id == ticketId
        && data.userId is string && isValidId(data.userId)
        && data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 160
        && data.message is string && data.message.size() >= 5 && data.message.size() <= 2000
        && data.status in ['open', 'in_progress', 'resolved']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. User & Private Subcollections
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId)
        && isValidUserPublic(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin())
        && isValidUserPublic(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredLanguage', 'selectedCity', 'aiPersonalizationOptIn', 'updatedAt']);

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isValidId(userId) && isValidId(docId) && isOwner(userId)
          && isValidUserPrivate(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin())
          && isValidUserPrivate(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'address', 'city', 'pincode', 'consentAcceptedAt', 'updatedAt']);
      }

      match /wishlists/{itemId} {
        allow get: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(itemId) && isOwner(userId)
          && isValidWishlistItem(incoming())
          && incoming().createdAt == request.time;
        allow delete: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
      }

      match /shoppingLists/{listId} {
        allow get: if isValidId(userId) && isValidId(listId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(listId) && isOwner(userId)
          && isValidShoppingList(incoming(), listId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(listId) && isOwner(userId)
          && isValidShoppingList(incoming(), listId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'budgetInr', 'items', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(listId) && isOwner(userId);
      }

      match /aiConversations/{conversationId} {
        allow get: if isValidId(userId) && isValidId(conversationId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(conversationId) && isOwner(userId)
          && isValidAiConversation(incoming(), conversationId)
          && incoming().createdAt == request.time;
        allow delete: if isValidId(userId) && isValidId(conversationId) && isOwner(userId);
      }
    }

    // 5. Admin & RBAC Collections
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(adminId) && isAdmin() && isValidAdminRecord(incoming(), adminId) && incoming().createdAt == request.time;
      allow update: if isValidId(adminId) && isAdmin() && isValidAdminRecord(incoming(), adminId) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(adminId) && isAdmin();
    }

    match /roles/{roleId} {
      allow get: if isValidId(roleId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(roleId) && isAdmin() && incoming().updatedAt == request.time;
      allow delete: if isValidId(roleId) && isAdmin();
    }

    // 6. Public Discovery & Catalogue Collections (Admin-Only Writes)
    match /universes/{universeId} {
      allow get: if isValidId(universeId);
      allow list: if true;
      allow create, update: if isValidId(universeId) && isAdmin()
        && incoming().keys().hasAll(['id', 'nameEn', 'nameHi', 'indoreOnly', 'active', 'sortOrder', 'updatedAt'])
        && incoming().id == universeId
        && incoming().nameEn is string && incoming().nameEn.size() >= 1 && incoming().nameEn.size() <= 100
        && incoming().nameHi is string && incoming().nameHi.size() >= 1 && incoming().nameHi.size() <= 100
        && (!('subtitleEn' in incoming()) || (incoming().subtitleEn is string && incoming().subtitleEn.size() <= 300))
        && (!('subtitleHi' in incoming()) || (incoming().subtitleHi is string && incoming().subtitleHi.size() <= 300))
        && (!('imageUrl' in incoming()) || (incoming().imageUrl is string && incoming().imageUrl.size() <= 500))
        && incoming().indoreOnly is bool
        && incoming().active is bool
        && incoming().sortOrder is int
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(universeId) && isAdmin();
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create, update: if isValidId(categoryId) && isAdmin()
        && incoming().keys().hasAll(['id', 'universeId', 'nameEn', 'active', 'updatedAt'])
        && incoming().id == categoryId
        && isValidId(incoming().universeId)
        && incoming().nameEn is string && incoming().nameEn.size() >= 1 && incoming().nameEn.size() <= 100
        && (!('nameHi' in incoming()) || (incoming().nameHi is string && incoming().nameHi.size() <= 100))
        && (!('descriptionEn' in incoming()) || (incoming().descriptionEn is string && incoming().descriptionEn.size() <= 300))
        && (!('descriptionHi' in incoming()) || (incoming().descriptionHi is string && incoming().descriptionHi.size() <= 300))
        && (!('imageUrl' in incoming()) || (incoming().imageUrl is string && incoming().imageUrl.size() <= 500))
        && (!('parentCategoryId' in incoming()) || incoming().parentCategoryId == '' || isValidId(incoming().parentCategoryId))
        && (!('sortOrder' in incoming()) || incoming().sortOrder is int)
        && incoming().active is bool
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    match /merchants/{merchantId} {
      allow get: if isValidId(merchantId);
      allow list: if true;
      allow create, update: if isValidId(merchantId) && isAdmin()
        && incoming().keys().hasAll(['id', 'name', 'type', 'status', 'indoreOnly', 'apiConfigured', 'affiliateDisclosureRequired', 'updatedAt'])
        && incoming().id == merchantId
        && incoming().name is string && incoming().name.size() <= 120
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(merchantId) && isAdmin();
    }

    match /products/{productId} {
      allow get: if isValidId(productId) && (existing().status == 'published' || isAdmin());
      allow list: if resource.data.status == 'published' || isAdmin();
      allow create, update: if isValidId(productId) && isAdmin()
        && incoming().keys().hasAll(['id', 'titleEn', 'universeId', 'categoryId', 'merchantId', 'purchaseMode', 'priceVerified', 'indoreOnly', 'status', 'updatedAt'])
        && incoming().id == productId
        && incoming().titleEn is string && incoming().titleEn.size() <= 180
        && incoming().purchaseMode in ['direct', 'external']
        && incoming().status in ['published', 'pending_approval', 'archived']
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(productId) && isAdmin();
    }

    match /productVariants/{variantId} {
      allow get: if isValidId(variantId);
      allow list: if true;
      allow create, update: if isValidId(variantId) && isAdmin() && incoming().id == variantId && incoming().updatedAt == request.time;
      allow delete: if isValidId(variantId) && isAdmin();
    }

    match /offers/{offerId} {
      allow get: if isValidId(offerId) && (existing().active == true || isAdmin());
      allow list: if resource.data.active == true || isAdmin();
      allow create, update: if isValidId(offerId) && isAdmin() && incoming().id == offerId && incoming().updatedAt == request.time;
      allow delete: if isValidId(offerId) && isAdmin();
    }

    match /mediaAssets/{assetId} {
      allow get: if isValidId(assetId);
      allow list: if true;
      allow create, update: if isValidId(assetId) && isAdmin() && incoming().id == assetId && incoming().updatedAt == request.time;
      allow delete: if isValidId(assetId) && isAdmin();
    }

    match /serviceAreas/{areaId} {
      allow get: if isValidId(areaId);
      allow list: if true;
      allow create, update: if isValidId(areaId) && isAdmin()
        && incoming().keys().hasAll(['id', 'city', 'pincode', 'locality', 'serviceable', 'eligibleMerchants', 'updatedAt'])
        && incoming().id == areaId
        && incoming().pincode is string && incoming().pincode.size() <= 10
        && incoming().eligibleMerchants is list && incoming().eligibleMerchants.size() <= 10
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(areaId) && isAdmin();
    }

    match /blogPosts/{postId} {
      allow get: if isValidId(postId) && (existing().status == 'published' || isAdmin());
      allow list: if resource.data.status == 'published' || isAdmin();
      allow create, update: if isValidId(postId) && isAdmin() && incoming().id == postId && incoming().updatedAt == request.time;
      allow delete: if isValidId(postId) && isAdmin();
    }

    match /banners/{bannerId} {
      allow get: if isValidId(bannerId) && (existing().active == true || isAdmin());
      allow list: if resource.data.active == true || isAdmin();
      allow create, update: if isValidId(bannerId) && isAdmin() && incoming().id == bannerId && incoming().updatedAt == request.time;
      allow delete: if isValidId(bannerId) && isAdmin();
    }

    // 7. Admin Operations & Affiliate Records
    match /affiliateCampaigns/{campaignId} {
      allow get: if isValidId(campaignId) && (existing().active == true || isAdmin());
      allow list: if resource.data.active == true || isAdmin();
      allow create, update: if isValidId(campaignId) && isAdmin()
        && incoming().keys().hasAll(['id', 'merchantId', 'name', 'isVerifiedPartner', 'active', 'updatedAt'])
        && incoming().id == campaignId
        && isValidId(incoming().merchantId)
        && incoming().name is string && incoming().name.size() >= 1 && incoming().name.size() <= 120
        && (!('description' in incoming()) || (incoming().description is string && incoming().description.size() <= 300))
        && incoming().isVerifiedPartner is bool
        && incoming().active is bool
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(campaignId) && isAdmin();
    }

    match /affiliateLinks/{linkId} {
      allow get: if isValidId(linkId) && (existing().active == true || isAdmin());
      allow list: if resource.data.active == true || isAdmin();
      allow create, update: if isValidId(linkId) && isAdmin()
        && incoming().keys().hasAll(['id', 'label', 'merchantId', 'destinationUrl', 'trackingCode', 'conversionTrackable', 'active', 'updatedAt'])
        && incoming().id == linkId
        && incoming().label is string && incoming().label.size() >= 1 && incoming().label.size() <= 140
        && isValidId(incoming().merchantId)
        && (!('campaignId' in incoming()) || incoming().campaignId == '' || isValidId(incoming().campaignId))
        && incoming().destinationUrl is string && incoming().destinationUrl.size() <= 500
        && isValidId(incoming().trackingCode)
        && (!('tags' in incoming()) || (incoming().tags is list && incoming().tags.size() <= 10 && (incoming().tags.size() == 0 || incoming().tags[0] is string)))
        && (!('disclosureNote' in incoming()) || (incoming().disclosureNote is string && incoming().disclosureNote.size() <= 300))
        && incoming().conversionTrackable is bool
        && (!('conversions' in incoming()) || (incoming().conversions is int && incoming().conversions >= 0))
        && incoming().active is bool
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(linkId) && isAdmin();
    }

    match /importJobs/{jobId} {
      allow get: if isValidId(jobId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(jobId) && isAdmin() && incoming().id == jobId && incoming().createdAt == request.time;
      allow update: if isValidId(jobId) && isAdmin() && incoming().id == jobId;
      allow delete: if isValidId(jobId) && isAdmin();
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId) && isAdmin()
        && incoming().keys().hasAll(['id', 'actorUid', 'action', 'targetPath', 'createdAt'])
        && incoming().keys().hasOnly(['id', 'actorUid', 'action', 'targetPath', 'createdAt'])
        && incoming().id == logId
        && incoming().actorUid == request.auth.uid
        && incoming().action is string && incoming().action.size() <= 120
        && incoming().targetPath is string && incoming().targetPath.size() <= 200
        && incoming().createdAt == request.time;
    }

    match /systemSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update: if isValidId(settingId) && isAdmin()
        && incoming().keys().hasAll(['id', 'aiSaathiEnabled', 'updatedAt'])
        && incoming().id == settingId
        && incoming().updatedAt == request.time;
    }

    // 8. Direct Orders, Payments, Refunds & Support Tickets
    match /directOrders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isVerified() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId) && isVerified()
        && isValidDirectOrder(incoming(), orderId)
        && incoming().userId == request.auth.uid
        && incoming().paymentStatus == 'created'
        && incoming().fulfillmentStatus == 'awaiting_payment'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(orderId)
        && isValidDirectOrder(incoming(), orderId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isVerified()
            && existing().userId == request.auth.uid
            && !(existing().fulfillmentStatus in ['delivered', 'cancelled'])
            && incoming().totalInr == existing().totalInr
            && incoming().items == existing().items
            && incoming().paymentStatus in ['pending_verification', 'failed']
            && incoming().diff(existing()).affectedKeys().hasOnly(['razorpayOrderId', 'razorpayPaymentId', 'paymentStatus', 'updatedAt'])
          )
        );
    }

    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && (isAdmin() || (isVerified() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
      allow create, update: if isValidId(paymentId) && isAdmin() && incoming().id == paymentId;
    }

    match /refunds/{refundId} {
      allow get: if isValidId(refundId) && (isAdmin() || (isVerified() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(refundId) && isVerified()
        && isValidRefund(incoming(), refundId)
        && incoming().userId == request.auth.uid
        && incoming().status == 'requested'
        && exists(/databases/$(database)/documents/directOrders/$(incoming().orderId))
        && get(/databases/$(database)/documents/directOrders/$(incoming().orderId)).data.userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(refundId) && isAdmin()
        && isValidRefund(incoming(), refundId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
    }

    match /supportTickets/{ticketId} {
      allow get: if isValidId(ticketId) && (isAdmin() || (isVerified() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(ticketId) && isVerified()
        && isValidSupportTicket(incoming(), ticketId)
        && incoming().userId == request.auth.uid
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(ticketId) && isAdmin()
        && isValidSupportTicket(incoming(), ticketId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
    }
  }
}
