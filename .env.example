# GEMINI_API_KEY: Required for Gemini AI API calls (Vedashila AI Saathi).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SITE_DOMAIN: Configurable public domain for Vedashila Lifestyle Hub (do not use vedashila.in).
SITE_DOMAIN=""

# RAZORPAY: Direct Vedashila Lifestyle Hub sales only (never expose SECRET in frontend).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# VEDASHILA.COM / FACTORI.COM AUTHORIZED FEED (Optional during development — API sync remains disabled until provided)
FACTORI_API_ENDPOINT=""
FACTORI_API_KEY=""

# AMAZON ASSOCIATES INDIA
# AMAZON_PARTNER_TAG can be used alone for manual Amazon Associates affiliate links.
# AMAZON_ACCESS_KEY and AMAZON_SECRET_KEY are optional during development (PA-API remains disabled until provided).
AMAZON_PARTNER_TAG=""
AMAZON_ACCESS_KEY=""
AMAZON_SECRET_KEY=""
